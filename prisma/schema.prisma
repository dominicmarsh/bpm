generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  image           String?
  emailVerified   DateTime?
  createdAt       DateTime           @default(now())
  garminCred      GarminCredential?
  biometrics      BiometricReading[]
  meetingSessions MeetingSession[]
  people          Person[]
  topics          Topic[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GarminCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  encryptedUsername String
  encryptedPassword String
  iv                String
  lastSyncAt        DateTime?
  user              User      @relation(fields: [userId], references: [id])
}

model BiometricReading {
  id          String   @id @default(cuid())
  userId      String
  timestamp   DateTime
  heartRate   Int?
  stressScore Int?
  bodyBattery Int?
  hrv         Float?
  source      String   @default("garmin")
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, timestamp])
}

model MeetingSession {
  id               String             @id @default(cuid())
  userId           String
  calendarEventId  String
  title            String
  startTime        DateTime
  endTime          DateTime
  attendeeEmails   String[]
  transcriptRaw    String?            @db.Text
  topics           String[]
  sentiment        String?
  meetingType      String?
  stressIndicators String[]
  enrichedAt       DateTime?
  biometrics       MeetingBiometrics?
  people           MeetingPerson[]
  topicLinks       MeetingTopic[]
  user             User               @relation(fields: [userId], references: [id])

  @@unique([userId, calendarEventId])
  @@index([userId, startTime])
}

model MeetingBiometrics {
  id               String         @id @default(cuid())
  meetingSessionId String         @unique
  avgHR            Float?
  peakHR           Int?
  baselineHR       Float?
  hrElevation      Float?
  avgStress        Float?
  peakStress       Int?
  avgBodyBattery   Float?
  bodyBatteryDelta Int?
  avgHrv           Float?
  hrvDelta         Float?
  meeting          MeetingSession @relation(fields: [meetingSessionId], references: [id])
}

model Person {
  id       String          @id @default(cuid())
  userId   String
  email    String
  name     String?
  team     String?
  meetings MeetingPerson[]
  user     User            @relation(fields: [userId], references: [id])

  @@unique([userId, email])
}

model Topic {
  id       String         @id @default(cuid())
  userId   String
  name     String
  meetings MeetingTopic[]
  user     User           @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model MeetingPerson {
  meetingId String
  personId  String
  meeting   MeetingSession @relation(fields: [meetingId], references: [id])
  person    Person         @relation(fields: [personId], references: [id])

  @@id([meetingId, personId])
}

model MeetingTopic {
  meetingId String
  topicId   String
  meeting   MeetingSession @relation(fields: [meetingId], references: [id])
  topic     Topic          @relation(fields: [topicId], references: [id])

  @@id([meetingId, topicId])
}
